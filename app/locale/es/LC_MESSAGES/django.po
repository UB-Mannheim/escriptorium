msgstr ""
"alineación layer nombre cannot be the same as the transcripción you are "
"trying to align."

#: apps/api/serializers.py apps/core/forms.py
msgid "Max offset and beam size cannot both be non-zero."
msgstr "Max offset and beam tamaño cannot both be non-zero."

