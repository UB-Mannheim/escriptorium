#: apps/api/serializers.py apps/core/forms.py
msgid "The transcription on which to perform alignment."
msgstr "La transcripción sobre la cual realizar la alineación."

#: apps/api/serializers.py apps/core/forms.py
msgid "The reference text for alignment; must be a .txt file."
msgstr "El texto de referencia para la alineación; debe ser un archivo .txt."

#: apps/api/serializers.py apps/core/forms.py
msgid "Reuse a previously-uploaded reference text."
msgstr "Reutilizar un texto de referencia subido previamente."

#: apps/api/serializers.py apps/core/forms.py
msgid "N-gram"
msgstr "N-grama"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Length (2–25) of token sequences to compare; 25 should work well for at "
"least moderately clean OCR. For very poor OCR, lower to 3 or 4."
msgstr ""
"Longitud (2–25) de secuencias de tokens a comparar; 25 debería funcionar "
"bien para OCR al menos moderadamente limpio. Para OCR muy pobre, reducir a 3 "
"o 4."

#: apps/api/serializers.py apps/core/forms.py
msgid "Max offset"
msgstr "Desplazamiento máximo"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Enables max-offset and disables beam search. Maximum number of characters "
"(20–80) difference between the aligned witness text and the original "
"transcription."
msgstr ""
"Habilita el desplazamiento máximo y deshabilita la búsqueda en haz. Número "
"máximo de caracteres (20–80) de diferencia entre el texto testigo alineado y "
"la transcripción original."

#: apps/api/serializers.py apps/core/forms.py
msgid "Beam size"
msgstr "Tamaño del haz"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Enables beam search; if this and max offset are left unset, beam search will "
"be on and beam size set to 20. Higher beam size (1-100) will result in "
"slower computation but more accurate results."
msgstr ""
"Habilita la búsqueda en haz; si esto y el desplazamiento máximo se dejan sin "
"configurar, la búsqueda en haz estará activada y el tamaño del haz se "
"establecerá en 20. Un tamaño de haz mayor (1-100) resultará en una "
"computación más lenta pero resultados más precisos."

#: apps/api/serializers.py apps/core/forms.py
msgid "Gap"
msgstr "Espacio"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"The distance between matching unique n-grams; 600 should work well for clean "
"OCR or texts where passages align to different portions of the witness text. "
"To force end-to-end alignment of two documents, increase to 1,000,000."
msgstr ""
"The distance between matching unique n-grams; 600 should work well for clean "
"OCR or texts where passages align to different portions of the witness "
"texto. To force end-to-end alineación of two documents, increase to "
"1,000,000."

#: apps/api/serializers.py apps/core/forms.py
msgid "Merge aligned text with existing transcription"
msgstr "Merge aligned texto with existing transcripción"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"If checked, the aligner will reuse the text of the original transcription "
"when alignment could not be performed; if unchecked, those lines will be "
"blank."
msgstr ""
"If checked, the aligner will reuse the texto of the original transcripción "
"when alineación could not be performed; if unchecked, those lines will be "
"blank."

#: apps/api/serializers.py apps/core/forms.py
msgid "Add hyphens"
msgstr "Añadir guiones"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"If checked, the aligner will attempt to reconstruct hyphenated words across "
"line breaks."
msgstr ""
"Si está marcado, el alineador intentará reconstruir palabras separadas por "
"guión en los saltos de línea."

#: apps/api/serializers.py apps/core/forms.py
msgid "Use full transcribed document"
msgstr "Usar documento completamente transcrito"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"If checked, the aligner will use all transcribed pages of the document to "
"find matches. If unchecked, it will compare each page to the text separately."
msgstr ""
"If checked, the aligner will use todos transcribed pages of the documento to "
"find matches. If unchecked, it will compare each página to the texto "
"separately."

#: apps/api/serializers.py apps/core/forms.py
msgid "Line length match threshold"
msgstr "línea length match threshold"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Minimum proportion (0.0–1.0) of aligned line length to original "
"transcription, below which matches are ignored. At 0.0, all matches are "
"accepted."
msgstr ""
"Minimum proportion (0.0–1.0) of aligned línea length to original "
"transcripción, below which matches are ignored. At 0.0, todos matches are "
"accepted."

#: apps/api/serializers.py apps/core/forms.py
msgid "Region types to include in the alignment."
msgstr "región types to include in the alineación."

#: apps/api/serializers.py apps/core/forms.py
msgid "Layer name"
msgstr "Layer nombre"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Name for the new transcription layer produced by this alignment. If you "
"reuse an existing layer name, the layer will be overwritten; use caution."
msgstr ""
"nombre for the nuevo transcripción layer produced by this alineación. If you "
"reuse an existing layer nombre, the layer will be overwritten; use caution."

#: apps/api/serializers.py apps/core/forms.py
msgid "You must supply a textual witness (reference text)."
msgstr "You must supply a textual witness (reference texto)."

#: apps/api/serializers.py apps/core/forms.py
msgid "You may only supply one witness text (file upload or existing text)."
msgstr ""
"You may only supply one witness texto (archivo subir or existing texto)."

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Alignment layer name cannot be the same as the transcription you are trying "
