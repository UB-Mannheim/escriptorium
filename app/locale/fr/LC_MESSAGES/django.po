msgid "All projects"
msgstr "Tous projets"

#: apps/core/forms.py
msgid ""
"Text to search in all of your projects, surround one or more terms with "
"quotation marks to deactivate fuzziness"
msgstr ""
"Texte à rechercher dans tous vos projets, entourez un ou plusieurs termes de "
"guillemets pour désactiver la recherche approximative"

#: apps/core/forms.py
msgid "Word by word"
msgstr "Mot par mot"

#: apps/core/forms.py
msgid "Regular expression"
msgstr "Expression régulière"

