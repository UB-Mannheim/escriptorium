#: apps/api/serializers.py
msgid "PDF is not a valid image, please use the dedicated Import function."
msgstr "קובץ PDF אינו תמונה תקינה, נא להשתמש בפונקציית הייבוא הייעודית."

#: apps/api/serializers.py apps/core/forms.py apps/imports/forms.py
#: escriptorium/templates/core/document_images.html
msgid "You don't have any disk storage left."
msgstr "אין לך עוד מקום באחסון הדיסק."

#: apps/api/serializers.py apps/core/forms.py apps/imports/forms.py
msgid "You don't have any CPU minutes left."
msgstr "אין לך עוד דקות CPU."

#: apps/api/serializers.py apps/core/forms.py
msgid "You don't have any GPU minutes left."
msgstr "אין לך עוד דקות GPU."

#: apps/api/serializers.py apps/core/forms.py
msgid "Lines and regions"
msgstr "שורות ואזורים"

#: apps/api/serializers.py apps/core/forms.py
msgid "Lines Baselines and Masks"
msgstr "שורות, קווי בסיס ומסיכות"

#: apps/api/serializers.py apps/core/forms.py
msgid "Only lines Masks"
msgstr "מסיכות שורות בלבד"

#: apps/api/serializers.py apps/core/forms.py
msgid "Regions"
msgstr "אזורים"

#: apps/api/serializers.py apps/core/forms.py apps/core/models.py
msgid "Horizontal l2r"
msgstr "אופקי משמאל לימין"

#: apps/api/serializers.py apps/core/forms.py apps/core/models.py
msgid "Horizontal r2l"
msgstr "אופקי מימין לשמאל"

#: apps/api/serializers.py apps/core/forms.py apps/core/models.py
msgid "Vertical l2r"
msgstr "אנכי משמאל לימין"

#: apps/api/serializers.py apps/core/forms.py apps/core/models.py
msgid "Vertical r2l"
msgstr "אנכי מימין לשמאל"

#: apps/api/serializers.py
msgid ""
"Either use model_name to create a new model, add a model pk to retrain an "
"existing one, or both to create a new model from an existing one."
msgstr "יש להשתמש ב-model_name ליצירת מודל חדש, להוסיף pk של מודל לאימון מחדש של \n"
"מודל קיים, או שניהם ליצירת מודל חדש ממודל קיים."

#: apps/api/serializers.py
msgid "Upload local file"
msgstr "העלאת קובץ מקומי"

#: apps/api/serializers.py
msgid "download file from url"
msgstr "הורדת קובץ מ-URL"

#: apps/api/serializers.py apps/imports/forms.py
#, python-format
msgid "Import in %(document_name)s"
msgstr "ייבוא אל %(document_name)s"

#: apps/api/serializers.py
msgid ""
"Either use model_name to create a new model, or add a model pk to retrain an "
"existing one."
msgstr "יש להשתמש ב-model_name ליצירת מודל חדש, או להוסיף pk של מודל לאימון מחדש של \n"
"מודל קיים."

#: apps/api/serializers.py apps/core/forms.py
msgid "The transcription on which to perform alignment."
msgstr "התעתוק שיוחל עליו המישור."

#: apps/api/serializers.py apps/core/forms.py
msgid "The reference text for alignment; must be a .txt file."
msgstr "טקסט הרפרנציה למישור; חייב להיות קובץ .txt."

#: apps/api/serializers.py apps/core/forms.py
msgid "Reuse a previously-uploaded reference text."
msgstr "שימוש מחדש בטקסט רפרנציה שהועלה קודם לכן."

#: apps/api/serializers.py apps/core/forms.py
msgid "N-gram"
msgstr "N-גרם"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Length (2–25) of token sequences to compare; 25 should work well for at "
"least moderately clean OCR. For very poor OCR, lower to 3 or 4."
msgstr "אורך (2–25) של רצפי טוקנים להשוואה; 25 אמור לעבוד טוב ל-OCR נקי יחסית. עבור \n"
"OCR ירוד מאוד, הורדו ל-3 או 4."

#: apps/api/serializers.py apps/core/forms.py
msgid "Max offset"
msgstr "הזזה מרבית"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Enables max-offset and disables beam search. Maximum number of characters "
"(20–80) difference between the aligned witness text and the original "
"transcription."
msgstr "מפעיל הזזה מרבית ומכבה חיפוש בימים. מספר התווים (20–80) המקסימלי כהפרש בין \n"
"טקסט העדה המשור לטקסט התעתוק המקורי."

#: apps/api/serializers.py apps/core/forms.py
msgid "Beam size"
msgstr "גודל בימים"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Enables beam search; if this and max offset are left unset, beam search will "
"be on and beam size set to 20. Higher beam size (1-100) will result in "
"slower computation but more accurate results."
msgstr "מפעיל חיפוש בימים; אם ערך זה וההזזה המרבית נשארים ריקים, חיפוש הבימים יהיה \n"
"פעיל בגודל 20. גודל בימים גבוה יותר (1-100) מוביל לחישוב איטי יותר אך \n"
"לתוצאות מדויקות יותר."

#: apps/api/serializers.py apps/core/forms.py
msgid "Gap"
msgstr "מרווח"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"The distance between matching unique n-grams; 600 should work well for clean "
"OCR or texts where passages align to different portions of the witness text. "
"To force end-to-end alignment of two documents, increase to 1,000,000."
msgstr "המרחק בין N-גרמים יחודיים תואמים; 600 אמור לעבוד טוב ל-OCR נקי או לטקסטים \n"
"שבהם קטעים מתאימים לחלקים שונים של טקסט העדה. כדי לכפות מישור מלא בין שני \n"
"מסמכים, הגדל ל-1,000,000."

#: apps/api/serializers.py apps/core/forms.py
msgid "Merge aligned text with existing transcription"
msgstr "מיזוג הטקסט המשור עם התעתוק הקיים"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"If checked, the aligner will reuse the text of the original transcription "
"when alignment could not be performed; if unchecked, those lines will be "
"blank."
msgstr "אם מסומן, המיישר יחזור וישתמש בטקסט של התעתוק המקורי כאשר לא ניתן לבצע \n"
"מישור; אם לא מסומן, שורות אלו יהיו ריקות."

#: apps/api/serializers.py apps/core/forms.py
msgid "Add hyphens"
msgstr "הוספת מקפים"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"If checked, the aligner will attempt to reconstruct hyphenated words across "
"line breaks."
msgstr "אם מסומן, המיישר ינסה לשחזר מילים עם מקף שנספרו על פני שורות."

#: apps/api/serializers.py apps/core/forms.py
msgid "Use full transcribed document"
msgstr "שימוש במסמך התעתוק המלא"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"If checked, the aligner will use all transcribed pages of the document to "
"find matches. If unchecked, it will compare each page to the text separately."
msgstr "אם מסומן, המיישר ישתמש בכל עמודי התעתוק של המסמך למציאת התאמות. אם לא מסומן,\n"
" כל עמוד ייבדק מול הטקסט בנפרד."

#: apps/api/serializers.py apps/core/forms.py
msgid "Line length match threshold"
msgstr "סף התאמת אורך שורה"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Minimum proportion (0.0–1.0) of aligned line length to original "
"transcription, below which matches are ignored. At 0.0, all matches are "
"accepted."
msgstr "יחס המינימום (0.0–1.0) בין אורך השורה המשור לתעתוק המקורי, מתחת לו התאמות \n"
"מתעלמות. ב-0.0 כל ההתאמות נקלטות."

#: apps/api/serializers.py apps/core/forms.py
msgid "Region types to include in the alignment."
msgstr "סוגי אזורים לכלול במישור."

#: apps/api/serializers.py apps/core/forms.py
msgid "Layer name"
msgstr "שם שכבה"

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Name for the new transcription layer produced by this alignment. If you "
"reuse an existing layer name, the layer will be overwritten; use caution."
msgstr "שם לשכבת התעתוק החדשה שנוצרה עקב מישור זה. אם תשתמש מחדש בשם שכבה קייمة, \n"
"השכבה תחולק; נא להיזהר."

#: apps/api/serializers.py apps/core/forms.py
msgid "You must supply a textual witness (reference text)."
msgstr "יש לספק עדה טקסטואלי (טקסט רפרנציה)."

#: apps/api/serializers.py apps/core/forms.py
msgid "You may only supply one witness text (file upload or existing text)."
msgstr "ניתן לספק רק עדה טקסטואלי אחד (העלאת קובץ או טקסט קיים)."

#: apps/api/serializers.py apps/core/forms.py
msgid ""
"Alignment layer name cannot be the same as the transcription you are trying "
"to align."
msgstr "שם שכבת המישור אינו יכול להיות זהה לתעתוק שאתה מנסה לשור."

#: apps/api/serializers.py apps/core/forms.py
msgid "Max offset and beam size cannot both be non-zero."
msgstr "ההזזה המרבית וגודל הבימים אינם יכולים להיות שניהם לא אפס."

#: apps/api/serializers.py
#, python-format
msgid "Invalid document_part: %(pk)s."
msgstr "document_part חסר תוקף: %(pk)s."

#: apps/api/serializers.py
#, python-format
msgid "Invalid transcription_layer: %(pk)s."
msgstr "transcription_layer חסר תוקף: %(pk)s."

#: apps/api/serializers.py
msgid ""
"Either use model_name to create a new model, or provide a base model pk to "
"retrain."
msgstr "יש להשתמש ב-model_name ליצירת מודל חדש, או לספק pk של מודל בסיס לאימון מחדש."

#: apps/api/serializers.py apps/core/forms.py
msgid "You can't overwrite the existing file of a model you don't own."
msgstr "אינך יכול לחלף את הקובץ הקיים של מודל שאינך הבעלים שלו."

#: apps/api/views.py apps/core/models.py
msgid "Canceled."
msgstr "בוטל."

#: apps/api/views.py
msgid "'lines' is mandatory."
msgstr "\"lines\" נדרש."

#: apps/api/views.py
msgid "None of the requested lines were found."
msgstr "אף אחת מהשורות הבוקשות לא נמצאה."

#: apps/api/views.py
msgid "Some lines could not be found in this part."
msgstr "חלק מהשורות לא נמצאו בחלק זה."

#: apps/core/forms.py
msgid "All projects"
msgstr "כל הפרויקטים"

#: apps/core/forms.py
msgid ""
"Text to search in all of your projects, surround one or more terms with "
"quotation marks to deactivate fuzziness"
msgstr "טקסט לחיפוש בכל הפרויקטים שלך; מקיף מושג אחד או יותר בגרשי ציון כדי לכבות \n"
"עמימות"

#: apps/core/forms.py
msgid "Word by word"
msgstr "מילה אחר מילה"

#: apps/core/forms.py
msgid "Regular expression"
msgstr "ביטוי רגולרי"

#: apps/core/forms.py
msgid "Text to replace"
msgstr "טקסט להחלפה"

#: apps/core/forms.py
msgid "Text to find"
msgstr "טקסט לאיתור"

#: apps/core/forms.py
msgid ""
"You cannot find and replace text across multiple projects at once, please "
"pick a single project before submitting your request."
msgstr "אינך יכול לחפש ולהחליף טקסט בפרויקטים רבים בו-זמנית, נא לבחור פרויקט אחד \n"
"לפני שליחת הבקשה."

#: apps/core/forms.py escriptorium/templates/core/models_list/rights/main.html
msgid "Type"
msgstr "סוג"

#: apps/core/forms.py
msgid "Color"
msgstr "צבע"

#: apps/core/forms.py
msgid "Allow Comments"
msgstr "אפשרות הערות"

#: apps/core/forms.py
msgid "The provided model could not be loaded."
msgstr "המודל הסופק לא נטען."

#: apps/core/forms.py
msgid ""
"Invalid model (Couldn't determine whether it's a segmentation or recognition "
"model)."
msgstr "מודל חסר תוקף (לא ניתן לקבוע האם זה מודל סגמנטציה או מודל זיהוי)."

#: apps/core/forms.py
msgid "eScriptorium is not compatible with bounding box models."
msgstr "eScriptorium אינו תואם מודלי bounding box."

#: apps/core/forms.py
msgid "Model"
msgstr "מודל"

#: apps/core/forms.py
#, python-brace-format
msgid "default ({name})"
msgstr "ברירת מחדל ({name})"

#: apps/core/forms.py
msgid ""
"If checked, deletes existing segmentation <b>and bound transcriptions</b> "
"first!"
msgstr "אם מסומן, מוחק קודם כל סגמנטציה קיימת <b>וגם תעתוקים מחוברים</b>!"

#: apps/core/forms.py
msgid "-- New --"
msgstr "-- חדש --"

#: apps/core/forms.py
msgid "The model is already training."
msgstr "המודל כבר במצב אימון."

#: apps/core/forms.py
msgid "Either choose a model name or overwrite an existing one."
msgstr "יש לבחור שם מודל או לחלף מודל קיים."

#: apps/core/forms.py
msgid ""
"You need to choose a model to override if the override option is checked."
msgstr "יש לבחור מודל להחלפה אם אפשרות ההחלפה מסומנת."

#: apps/core/forms.py
msgid "Overwrite existing model file"
msgstr "החלפת קובץ מודל קיים"

#: apps/core/forms.py
msgid "Empty Ground Truth data."
msgstr "נתוני Ground Truth ריקים."

#: apps/core/forms.py
msgid "Migrate with associated tags"
msgstr "העברה כולל תגים מקושרים"

#: apps/core/models.py
msgid "Comma separated list of possible value, leave it empty for free input."
msgstr "רשימת ערכים אפשריים מופרדת בפסיק; השאר ריק להזנה חופשית."

#: apps/core/models.py
msgid "Rectangle"
msgstr "מלבן"

#: apps/core/models.py
msgid "Polygon"
msgstr "פוליגון"

#: apps/core/models.py
msgid "Background Color"
msgstr "צבע רקע"

#: apps/core/models.py
msgid "Text Color"
msgstr "צבע טקסט"

#: apps/core/models.py
msgid "Bold"
msgstr "מודגש"

#: apps/core/models.py
msgid "Italic"
msgstr "נטוי"

#: apps/core/models.py
msgid "Top to bottom"
msgstr "מלמעלה למטה"

#: apps/core/models.py
msgid "baseline"
msgstr "קו בסיס"

#: apps/core/models.py
msgid "middle"
msgstr "אמצע"

#: apps/core/models.py
msgid "top"
msgstr "ראש"

#: apps/core/models.py
msgid "bottom"
msgstr "תחתית"

#: apps/core/models.py
msgid "text top"
msgstr "ראש טקסט"

#: apps/core/models.py
msgid "text bottom"
msgstr "תחתית טקסט"

#: apps/core/models.py
msgid "subscript"
msgstr "תג מטה"

#: apps/core/models.py
msgid "superscript"
msgstr "תג מעלה"

#: apps/core/models.py
msgid "ttf, otf, woff or woff2"
msgstr "ttf, otf, woff או woff2"

#: apps/core/models.py
msgid "size"
msgstr "גודל"

#: apps/core/models.py
msgid "scale factor, 1.0 keeps the font as it is"
msgstr "מקדם קינה; 1.0 שומר על הגופן כמות שהוא"

#: apps/core/models.py
msgid "ascent"
msgstr "עלייה"

#: apps/core/models.py
msgid "room above the baseline, raise it when tall glyphs get cut"
msgstr "מרווח מעל קו הבסיס; הגדל אם תווים גבוהים נחתכים"

#: apps/core/models.py
msgid "descent"
msgstr "ירידה"

#: apps/core/models.py
msgid "room below the baseline, raise it when low glyphs get cut"
msgstr "מרווח מתחת לקו הבסיס; הגדל אם תווים נמוכים נחתכים"

#: apps/core/models.py
msgid "line height"
msgstr "גובה שורה"

#: apps/core/models.py
msgid "in em, empty keeps the default"
msgstr "ביחידת em; ריק שומר על ברירת המחדל"

#: apps/core/models.py
msgid "height"
msgstr "גובה"

#: apps/core/models.py
msgid "in em, empty uses 1.1"
msgstr "ביחידת em; ריק משתמש ב-1.1"

#: apps/core/models.py
msgid "top padding"
msgstr "ריפוד עליון"

#: apps/core/models.py
msgid "in em, moves the text down"
msgstr "ביחידת em; מזיז את הטקסט מטה"

#: apps/core/models.py
msgid "bottom padding"
msgstr "ריפוד תחתון"

#: apps/core/models.py
msgid "in em, moves the text up"
msgstr "ביחידת em; מזיז את הטקסט למעלה"

#: apps/core/models.py
msgid "top margin"
msgstr "שולי עליון"

#: apps/core/models.py
msgid "in em, moves the box down"
msgstr "ביחידת em; מזיז את השדה מטה"

#: apps/core/models.py
msgid "bottom margin"
msgstr "שולי תחתון"

#: apps/core/models.py
msgid "in em, can be negative to take back the top padding"
msgstr "ביחידת em; יכול להיות שלילי כדי לבטל את הריפוד העליון"

#: apps/core/models.py
msgid "vertical align"
msgstr "יישור אנכי"

#: apps/core/models.py
msgid "empty keeps the default"
msgstr "ריק שומר על ברירת המחדל"

#: apps/core/models.py
msgid ""
"An optional URL pointing to an external document that explains content "
"editing and authorship guidelines for this project, in order to guide a team "
"or group towards consistent practices for manual segmentation/transcription."
msgstr "כתובת URL אופציונלית המכוונת למסמך חיצוני המסביר הנחיות לעריכת תוכן ולכתיבה \n"
"עבור פרויקט זה, כדי להנחות קבוצה או צוות לקראת דרכים עקביות לסגמנטציה/תעתוק \n"
"ידניים."

#: apps/core/models.py
msgid "Share with users"
msgstr "שיתוף עם משתמשים"

#: apps/core/models.py
msgid "Share with teams"
msgstr "שיתוף עם קבוצות"

#: apps/core/models.py
msgid ""
"Font used to render transcription content for documents in this project, "
"unless overridden at the document level."
msgstr "הגופן המשמש להצגת תוכן התעתוק של מסמכים בפרויקט זה, אלא אם נעשה עידון ברמת \n"
"המסמך."

#: apps/core/models.py
msgid "Draft"
msgstr "גרוטאה"

#: apps/core/models.py
msgid "Published"
msgstr "פורסם"

#: apps/core/models.py
msgid "Archived"
msgstr "אורכב"

#: apps/core/models.py
msgid "Left to right"
msgstr "משמאל לימין"

#: apps/core/models.py
msgid "Right to left"
msgstr "מימין לשמאל"

#: apps/core/models.py
msgid "Baseline"
msgstr "קו בסיס"

#: apps/core/models.py
msgid "Topline"
msgstr "קו עליון"

#: apps/core/models.py
msgid "Centered"
msgstr "ממוקם במרכז"

#: apps/core/models.py
msgid ""
"The read direction describes the order of the elements in the document, in "
"opposition with the text direction which describes the order of the words in "
"a line and is set by the script."
msgstr "כיוון הקריאה מתאר את סדר הרכיבים במסמך, בעוד שכיוון הכתיבה מתאר את סדר \n"
"המילים בשורה ונקבע לפי הכתיב."

#: apps/core/models.py
msgid "The position of the line relative to the polygon."
msgstr "מיקום השורה ביחס לפוליגון."

#: apps/core/models.py
msgid "Show confidence visualizations"
msgstr "הצגת ויזואליזציות ביטחון"

#: apps/core/models.py
msgid ""
"If checked, enable toggling on and off colorized overlays for automatic "
"transcription (OCR/HTR) confidences."
msgstr "אם מסומן, מאפשר הפעלה וכיבון של שכבות צבע על-גבי תעתוק אוטומטי (OCR/HTR) לפי\n"
" רמת הביטחון."

